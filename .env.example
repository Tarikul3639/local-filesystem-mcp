# HTTP Server Configuration
HTTP_HOST=127.0.0.1
HTTP_PORT=3002

# Allowed filesystem roots (separate multiple paths with : on Linux/macOS)
FILESYSTEM_ROOTS=/home/your-user/Desktop:/home/your-user/Downloads
FILESYSTEM_READ_ONLY=false

# Security boundaries
# true blocks access to the root folder itself but still allows its child paths
FILESYSTEM_DENY_ROOT_ACCESS=true

# run_command accepts arbitrary executable names, except the security denylist.
# Blocked commands are checked on every invocation; see README.md for limitations.

# Absolute paths to private folders/files that must never be accessed.
# Separate multiple paths with : on Linux/macOS.
FILESYSTEM_BLOCKED_PATHS=/home/your-user/Desktop/Private:/home/your-user/Documents/Confidential

# .env, .env.local, .env.production etc. are blocked by default.
# .env.example remains accessible regardless of this setting.
FILESYSTEM_ALLOW_ENV_FILES=false

# MCP Authentication
MCP_AUTH_TOKEN=replace-with-a-long-random-secret
